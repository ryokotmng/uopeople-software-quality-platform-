# Example configuration for the Software Quality Platform.
# Copy to `.env` and adjust. `.env` is git-ignored and never committed.

# Runtime environment: development | ci | production
APP_ENV=development

# HTTP listen address for the dashboard.
ADDR=:8080

# Directory holding runtime state (user store + test-run results).
DATA_DIR=data

# Repository the orchestrator runs `go test` against.
REPO_DIR=.

# Seed administrative account. Only authenticated users may trigger runs.
# Change these before any non-local use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Reserved for a future shared metrics store (PostgreSQL). When empty,
# results are persisted as JSON files under DATA_DIR. Example:
# DATABASE_URL=postgres://user:pass@localhost:5432/sqp?sslmode=disable
DATABASE_URL=
